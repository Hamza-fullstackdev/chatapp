# Copy to app/.env and adjust for your environment.
# Prefix EXPO_PUBLIC_ so these are inlined into the app bundle at build time.
# Never store secrets here — everything is visible in the app.

# Backend API (see api/). Use your machine's LAN IP when running on a physical device:
#   npm -g i # or run api with: npm run dev
#   Example: EXPO_PUBLIC_API_URL=http://192.168.1.10:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# Supabase project (public values — safe to embed in the app)
