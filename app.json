{
  "expo": {
    "name": "HAMI",
    "slug": "hami",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/launcher.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/launcher.png",
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00A884",
        "foregroundImage": "./assets/images/launcher.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.hamidev.app",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/launcher.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00A884",
          "image": "./assets/images/spash-logo.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#00A884",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to send images in chat.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to send photos and join video calls.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to use your microphone to record audio and join voice calls."
        }
      ],
      "expo-document-picker",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to view and hear saved media.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save downloaded media to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera for video calls.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to use your microphone for voice calls."
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "useLegacyPackaging": true
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5dcc974a-f6b2-42c3-85cf-23e8ed977434"
      }
    }
  }
}
